# Dedicated Labs buyer wallet. Do not reuse the treasury key or a user wallet.
LMX_LABS_WALLET_PRIVATE_KEY=0x

# Optional. Tried first, then publicnode, 1rpc, and mainnet.base.org.
# Not the shared BASE_RPC_URL.
# LMX_LABS_RPC_URL=https://mainnet.base.org

# Optional per-run USDC ceiling. Default 0.25. Hard ceiling is $1.
# LMX_LABS_SPEND_CAP_USDC=0.25

# Optional per-request timeout in milliseconds. Default 120000.
# LMX_LABS_TIMEOUT_MS=120000
