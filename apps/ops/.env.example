# Ops dashboard (Vite) — copy to apps/ops/.env for local auto-connect
VITE_API_URL=http://127.0.0.1:3000
# Same value as LMX_OPS_API_KEY on the API. When set, the UI connects automatically.
# VITE_OPS_API_KEY=

# Funded LMX user key (lmx_...) owned by ops — pays for notification drafts via
# /v1/chat/completions (balance path, not x402). Not the ops secret.
# Same pattern: set here for local auto-connect, or paste in the Notifications UI.
# VITE_OPS_GRID_API_KEY=
