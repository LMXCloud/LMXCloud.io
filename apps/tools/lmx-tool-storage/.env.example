# Local standalone server (pnpm --filter @lmxcloud/lmx-tool-storage dev)
# This package loads ONLY this folder's .env — never the repo-root LMX database.
PORT=8788
HOST=0.0.0.0

# Optional. When unset, a local SQLite file is used automatically at data/vault.db
# (created on first boot, gitignored). Set this to use your own Postgres instead —
# a different database than apps/api, never the repo-root LMX DATABASE_URL.
# DATABASE_URL=postgres://lmx:lmx@localhost:5432/lmx_storage

# Consolidation only (POST /:namespace/consolidate). PUT/GET/query/search ignore these.
# This is the vault's own Grid identity — not an agent's, and this service does not mint one.
# LMX_API_URL=https://api.lmxcloud.io
# LMX_API_KEY=
# LMX_MODEL=mistral-nemo
