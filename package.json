{
  "name": "lmxcloud",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @lmxcloud/shared build && pnpm --filter @lmxcloud/x402 build && pnpm --filter @lmxcloud/api dev",
    "dev:demo": "pnpm --filter @lmxcloud/demo dev",
    "dev:cli": "pnpm --filter @lmxcloud/cli dev",
    "dev:mcp": "pnpm --filter @lmxcloud/mcp-server dev",
    "dev:mcp:http": "pnpm --filter @lmxcloud/mcp-server dev:http",
    "dev:pdf-extract": "pnpm --filter @lmxcloud/pdf-extract dev",
    "dev:tools-host": "pnpm --filter @lmxcloud/pdf-extract build && pnpm --filter @lmxcloud/tools-host dev",
    "dev:web": "pnpm --filter @lmxcloud/shared build && pnpm --filter @lmxcloud/web dev",
    "build": "pnpm --filter @lmxcloud/shared build && pnpm --filter @lmxcloud/x402 build && pnpm --filter @lmxcloud/api build && pnpm --filter @lmxcloud/demo build && pnpm --filter @lmxcloud/mcp-server build && pnpm --filter @lmxcloud/web build && pnpm --filter @lmxcloud/ops build",
    "build:demo": "pnpm --filter @lmxcloud/demo build",
    "build:pdf-extract": "pnpm --filter @lmxcloud/pdf-extract build",
    "build:tools-host": "pnpm --filter @lmxcloud/pdf-extract build && pnpm --filter @lmxcloud/tools-host build",
    "build:web": "pnpm --filter @lmxcloud/web build",
    "typecheck": "pnpm --filter @lmxcloud/shared build && pnpm --filter @lmxcloud/x402 build && pnpm -r typecheck",
    "start": "pnpm --filter @lmxcloud/api start",
    "start:pdf-extract": "pnpm --filter @lmxcloud/pdf-extract start",
    "start:tools-host": "pnpm --filter @lmxcloud/tools-host start",
    "deploy:anchor": "pnpm --filter @lmxcloud/api deploy:anchor",
    "deploy:anchor:mainnet": "pnpm --filter @lmxcloud/api deploy:anchor:mainnet",
    "verify:receipt": "pnpm --filter @lmxcloud/api verify:receipt",
    "dev:ops": "pnpm --filter @lmxcloud/ops dev",
    "build:ops": "pnpm --filter @lmxcloud/ops build"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
